# ─────────────────────────────────────────────────────────────
# REELCLICKS.IN — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. NEXT_PUBLIC_* values are visible in the browser.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (Phase 2) — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Server-only token with Editor rights (seed script + saving enquiries)
SANITY_API_WRITE_TOKEN=
# Shared secret for the on-demand revalidation webhook
SANITY_REVALIDATE_SECRET=

# Video streaming — Bunny Stream (preferred) or Mux (Phase 1/3)
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=
# Optional Mux alternative
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Email — Resend (Phase 8)
RESEND_API_KEY=
RESEND_FROM_EMAIL="REELCLICKS.IN <onboarding@resend.dev>"
ENQUIRY_TO_EMAIL=huzefshaikh940@gmail.com

# Spam protection — Cloudflare Turnstile (Phase 8)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instagram feed — Behold.so (Phase 3)
NEXT_PUBLIC_BEHOLD_FEED_ID=

# Analytics (Phase 9)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
